PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/skyline_clubhub
# Set true only on a replica set (Atlas or local rs). Standalone mongod does not support transactions.
MONGO_TRANSACTIONS=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# Annual membership fee in paise (50000 = Rs 500)
MEMBERSHIP_FEE_PAISE=50000
# Minutes before an unpaid order is expired and its seats released
ORDER_HOLD_MINUTES=15
# Used by npm run seed:admin
ADMIN_EMAIL=admin@skyline.edu
ADMIN_PASSWORD=ChangeMe123!
